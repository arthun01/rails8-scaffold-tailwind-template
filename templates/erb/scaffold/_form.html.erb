<%%= form_with(model: <%= singular_table_name %>, class: "space-y-5") do |form| %>
  <%% if <%= singular_table_name %>.errors.any? %>
    <div class="flex gap-3 p-4 bg-red-50 border border-red-200 rounded-2xl">
      <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-red-100 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0"/><path d="M12 16h.01"/></svg>
      </div>
      <div>
        <h3 class="font-bold text-red-800 text-sm mb-1">
          <%%= pluralize(<%= singular_table_name %>.errors.count, "erro") %> encontrado(s):
        </h3>
        <ul class="text-xs text-red-600 space-y-0.5 list-disc list-inside">
          <%% <%= singular_table_name %>.errors.full_messages.each do |message| %>
            <li><%%= message %></li>
          <%% end %>
        </ul>
      </div>
    </div>
  <%% end %>

  <% attributes.reject { |attr| attr.name == 'id' || attr.attachment? }.each do |attribute| -%>
    <div class="space-y-1.5">
      <%%= form.label :<%= attribute.name %>, class: "block text-sm font-semibold text-gray-700" %>

      <% if attribute.field_type == :text_area -%>
        <%%= form.text_area :<%= attribute.name %>,
            rows: 4,
            placeholder: "Digite aqui...",
            class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 transition resize-none" %>

      <% elsif attribute.field_type == :boolean -%>
        <label class="flex items-center gap-3 p-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:bg-indigo-50 hover:border-indigo-200 transition group">
          <%%= form.check_box :<%= attribute.name %>, { class: "w-4 h-4 accent-indigo-600 cursor-pointer" }, "true", "false" %>
          <span class="text-sm text-gray-700 group-hover:text-indigo-700 font-medium">
            <%%= <%= class_name %>.human_attribute_name(:<%= attribute.name %>) %>
          </span>
        </label>

      <% elsif attribute.field_type == :datetime_select -%>
        <%%= form.datetime_select :<%= attribute.name %>,
            class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 transition" %>

      <% elsif attribute.field_type == :date_select -%>
        <%%= form.date_field :<%= attribute.name %>,
            class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 transition" %>

      <% elsif attribute.field_type == :time_select -%>
        <%%= form.time_field :<%= attribute.name %>,
            class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 transition" %>

      <% elsif attribute.reference? -%>
        <%%= form.collection_select :<%= attribute.name %>_id,
            <%= attribute.name.classify %>.all,
            :id,
            :to_s,
            { prompt: "Selecione uma opção..." },
            class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 transition appearance-none" %>

      <% else -%>
        <%%= form.<%= attribute.field_type %> :<%= attribute.name %>,
            placeholder: "Digite aqui...",
            class: "w-full px-4 py-3 border border-gray-200 rounded-xl text-sm text-gray-900 placeholder-gray-400 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 transition" %>
      <% end -%>
    </div>
  <% end -%>

  <!-- Botões -->
  <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100">
    <%%= form.submit <%= singular_table_name %>.new_record? ? "Criar registro" : "Salvar alterações",
        class: "flex-1 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white font-semibold py-3 px-5 rounded-xl transition-all duration-200 shadow-md shadow-indigo-200 hover:shadow-lg hover:shadow-indigo-300 cursor-pointer text-sm" %>
    <%%= link_to "Cancelar", <%= plural_table_name %>_path,
        class: "flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-5 rounded-xl transition-colors text-sm" %>
  </div>
<%% end %>
