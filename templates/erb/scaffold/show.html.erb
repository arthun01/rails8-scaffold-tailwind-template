<div class="min-h-screen bg-gradient-to-br from-slate-50 via-indigo-50/30 to-violet-50/20 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-indigo-500 to-violet-600"></div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
            <%%= "#{<%= class_name %>.model_name.human} ID: #{@<%= singular_table_name %>.id}" %>
          </h1>
        </div>
        <p class="text-gray-500 text-sm ml-3">Detalhes do(a) registro</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%%= link_to edit_<%= singular_table_name %>_path(@<%= singular_table_name %>),
            class: "inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors shadow-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"/><path d="M13.5 6.5l4 4"/></svg>
          Editar
        <%% end %>
        <%%= link_to @<%= singular_table_name %>,
            data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar este registro?" },
            class: "inline-flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors shadow-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l16 0"/><path d="M10 11l0 6"/><path d="M14 11l0 6"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/></svg>
          Apagar
        <%% end %>
      </div>
    </div>

    <!-- Atributos -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-4">
      <% attributes.reject { |attr| attr.name == 'id' || attr.attachment? }.each do |attribute| -%>
        <div class="flex flex-col sm:flex-row sm:items-start gap-2 px-6 py-5 border-b border-gray-50 last:border-b-0">
          <p class="text-xs font-bold text-gray-400 uppercase tracking-widest sm:w-40 flex-shrink-0 pt-0.5">
            <%%= <%= class_name %>.human_attribute_name(:<%= attribute.name %>) %>
          </p>
          <div class="text-sm text-gray-800 font-medium flex-1">
            <% if attribute.field_type == :boolean -%>
              <%% if @<%= singular_table_name %>.<%= attribute.name %> %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Sim
                </span>
              <%% else %>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full bg-gray-50 text-gray-500 ring-1 ring-gray-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Não
                </span>
              <%% end %>
            <% elsif attribute.field_type == :text_area -%>
              <div class="bg-gray-50 rounded-xl p-4 text-gray-700 whitespace-pre-wrap text-sm leading-relaxed">
                <%%= @<%= singular_table_name %>.<%= attribute.name %> %>
              </div>
            <% else -%>
              <%%= @<%= singular_table_name %>.<%= attribute.name %> %>
            <% end -%>
          </div>
        </div>
      <% end -%>
    </div>

    <!-- Metadados -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
      <div class="bg-white rounded-2xl border border-gray-100 px-5 py-4 shadow-sm">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Criado em</p>
        <p class="text-sm font-semibold text-gray-700"><%%= l(@<%= singular_table_name %>.created_at) if @<%= singular_table_name %>.created_at %></p>
      </div>
      <div class="bg-white rounded-2xl border border-gray-100 px-5 py-4 shadow-sm">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Atualizado em</p>
        <p class="text-sm font-semibold text-gray-700"><%%= l(@<%= singular_table_name %>.updated_at) if @<%= singular_table_name %>.updated_at %></p>
      </div>
    </div>

    <!-- Voltar -->
    <%%= link_to <%= plural_table_name %>_path,
        class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-indigo-600 transition-colors" do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0"/><path d="M5 12l6 6"/><path d="M5 12l6 -6"/></svg>
      Voltar para lista
    <%% end %>
  </div>
</div>
