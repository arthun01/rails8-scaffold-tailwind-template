<% flash.each do |key, message| %>
  <%
    type = key.to_sym
    styles = case type
    when :notice, :success
      { bg: "from-emerald-50 to-green-50", border: "border-emerald-200", dot: "bg-emerald-500", text: "text-emerald-800", subtext: "text-emerald-600" }
    when :alert, :error
      { bg: "from-red-50 to-rose-50", border: "border-red-200", dot: "bg-red-500", text: "text-red-800", subtext: "text-red-600" }
    when :warning
      { bg: "from-amber-50 to-yellow-50", border: "border-amber-200", dot: "bg-amber-500", text: "text-amber-800", subtext: "text-amber-600" }
    else
      { bg: "from-indigo-50 to-violet-50", border: "border-indigo-200", dot: "bg-indigo-500", text: "text-indigo-800", subtext: "text-indigo-600" }
    end

    icon_svg = case type
    when :notice, :success
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>'
    when :alert, :error
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>'
    when :warning
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>'
    else
      '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
    end
  %>
  <div class="anim-fade flex items-start gap-3 p-4 rounded-2xl border bg-gradient-to-br <%= styles[:bg] %> <%= styles[:border] %> shadow-lg shadow-black/5"
       role="alert"
       data-controller="flash"
       data-action="animationend->flash#remove">
    <div class="flex-shrink-0 w-8 h-8 rounded-full <%= styles[:dot] %> flex items-center justify-center">
      <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <%= icon_svg.html_safe %>
      </svg>
    </div>
    <div class="flex-1 min-w-0 pt-0.5">
      <p class="text-sm font-semibold <%= styles[:text] %>"><%= message %></p>
    </div>
    <button type="button"
            class="flex-shrink-0 p-1 rounded-lg <%= styles[:subtext] %> hover:bg-black/5 transition"
            onclick="this.closest('[role=alert]').remove()">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
<% end %>
